            count ? '取得元のはてなブックマーク (' + count + ')' : '取得元のはてなブックマークはありません'));
        box.append(h);
        const ul = el('ul', {class: 'list-unstyled small ms-2'});
        (json && json.bookmarks || []).filter(b => b.comment).slice(0, 10).forEach(b => {
            const ymd = String(b.timestamp || '').split(' ')[0];
            const li = el('li', {class: 'mb-1'});
            li.append(el('span', {class: 'text-secondary'}, ymd), ' ',
