                                    <i class="bi bi-x text-danger clickable" onclick="deleteBookmark('${data.url}')"><\/i>
                                <\/td>
                            `;
                                                        tbody.appendChild(row);
                                                        displayed++;
                                                    }
                                                }
                                            }
                                            count++;
                                            cursor.continue();
                                        } else {
                                            isLoading = false;
                                            noBookmarksMessage.classList.toggle('d-none', tbody.children.length > 0);
