                                            }
                                        };
                                    }
                                };

                                window.clearAllBookmarks = function() {
                                    if (confirm('すべてのブックマークを削除してもよろしいですか？')) {
                                        const transaction = db.transaction(['bookmarks'], 'readwrite');
