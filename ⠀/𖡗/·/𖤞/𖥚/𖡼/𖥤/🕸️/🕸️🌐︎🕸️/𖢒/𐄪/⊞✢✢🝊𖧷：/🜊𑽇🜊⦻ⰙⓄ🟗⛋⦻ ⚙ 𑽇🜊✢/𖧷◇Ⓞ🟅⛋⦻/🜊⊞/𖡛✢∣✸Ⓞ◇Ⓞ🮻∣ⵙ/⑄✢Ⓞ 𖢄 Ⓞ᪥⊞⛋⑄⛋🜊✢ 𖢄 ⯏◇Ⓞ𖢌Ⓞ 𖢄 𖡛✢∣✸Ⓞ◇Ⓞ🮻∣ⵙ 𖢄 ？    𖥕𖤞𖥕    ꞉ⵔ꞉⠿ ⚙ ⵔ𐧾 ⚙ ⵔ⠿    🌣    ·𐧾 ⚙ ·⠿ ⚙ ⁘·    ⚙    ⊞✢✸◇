function getXmlHttp(){
  var xmlhttp;
  try {
    xmlhttp = new ActiveXObject("Msxml2.XMLHTTP");
  } catch (e) {
    try {
      xmlhttp = new ActiveXObject("Microsoft.XMLHTTP");
    } catch (E) {
      xmlhttp = false;
    }
  }
  if (!xmlhttp && typeof XMLHttpRequest!='undefined') {
    xmlhttp = new XMLHttpRequest();
  }
  return xmlhttp;
}


// javascript-код голосования из примера
function zapros(t) {
	var req = getXmlHttp()
	var statusElem = document.getElementById('status') //ход выполнения
	req.onreadystatechange = function() { // onreadystatechange активируется при получении ответа сервера
		if (req.readyState == 4) { // если запрос закончил выполняться
			if(req.status == 200) {
				// если статус 200 (ОК) - выдать ответ пользователю
				//alert("Ответ сервера: "+req.responseText);
				statusElem.innerHTML = 'Запрос: ' + req.statusText; //показать статус выполнения (Not Found, ОК...)
				document.getElementById("otvet").innerHTML = req.responseText;
				//response = req.responseText.split(" ");
				//document.getElementById("otvet").innerHTML = response[0];
				//document.getElementById("sin2").innerHTML =	response[1].replace(/\n/g, "");
			}
			else alert("Ответ сервера: "+req.responseText);
		}
	}
	//req.open('GET', 'https://energodar.net/plugins/ajax/slovar.php?slovo='+t, true);
	req.open('GET', 'https://energodar.net/plugin/ajax/slovar.php?slovo='+t, true);
