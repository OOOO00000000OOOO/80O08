        s.src = 'https://b.hatena.ne.jp/entry/jsonlite/?callback=' + cb + '&url=' + encodeURIComponent(url);
        document.body.append(s);
    };
    if (true) {
        // ページが短くスクロールできない場合も、下向きのホイール/タッチ操作があれば最下部到達とみなす
        const events = ['scroll', 'wheel', 'touchmove'];
        const onScroll = () => {
            const root = document.documentElement;
            if (window.innerHeight + window.scrollY < root.scrollHeight - 100) return;
            events.forEach(t => window.removeEventListener(t, onScroll));
            load();
        };
        events.forEach(t => window.addEventListener(t, onScroll, {passive: true}));
        return;
    }
    new IntersectionObserver((entries, io) => {
        if (entries.some(e => e.isIntersecting)) { io.disconnect(); load(); }
    }).observe(box);
