                                '<dt>💡&nbsp;発見しました<\/dt>' +
                                '<dd><a href="' + recent_url.toString() + '" target="_blank" rel="nofollow">最新 ' + recent_date_str + '(' + recent_url.hostname + ')<\/a><\/dd>' +
