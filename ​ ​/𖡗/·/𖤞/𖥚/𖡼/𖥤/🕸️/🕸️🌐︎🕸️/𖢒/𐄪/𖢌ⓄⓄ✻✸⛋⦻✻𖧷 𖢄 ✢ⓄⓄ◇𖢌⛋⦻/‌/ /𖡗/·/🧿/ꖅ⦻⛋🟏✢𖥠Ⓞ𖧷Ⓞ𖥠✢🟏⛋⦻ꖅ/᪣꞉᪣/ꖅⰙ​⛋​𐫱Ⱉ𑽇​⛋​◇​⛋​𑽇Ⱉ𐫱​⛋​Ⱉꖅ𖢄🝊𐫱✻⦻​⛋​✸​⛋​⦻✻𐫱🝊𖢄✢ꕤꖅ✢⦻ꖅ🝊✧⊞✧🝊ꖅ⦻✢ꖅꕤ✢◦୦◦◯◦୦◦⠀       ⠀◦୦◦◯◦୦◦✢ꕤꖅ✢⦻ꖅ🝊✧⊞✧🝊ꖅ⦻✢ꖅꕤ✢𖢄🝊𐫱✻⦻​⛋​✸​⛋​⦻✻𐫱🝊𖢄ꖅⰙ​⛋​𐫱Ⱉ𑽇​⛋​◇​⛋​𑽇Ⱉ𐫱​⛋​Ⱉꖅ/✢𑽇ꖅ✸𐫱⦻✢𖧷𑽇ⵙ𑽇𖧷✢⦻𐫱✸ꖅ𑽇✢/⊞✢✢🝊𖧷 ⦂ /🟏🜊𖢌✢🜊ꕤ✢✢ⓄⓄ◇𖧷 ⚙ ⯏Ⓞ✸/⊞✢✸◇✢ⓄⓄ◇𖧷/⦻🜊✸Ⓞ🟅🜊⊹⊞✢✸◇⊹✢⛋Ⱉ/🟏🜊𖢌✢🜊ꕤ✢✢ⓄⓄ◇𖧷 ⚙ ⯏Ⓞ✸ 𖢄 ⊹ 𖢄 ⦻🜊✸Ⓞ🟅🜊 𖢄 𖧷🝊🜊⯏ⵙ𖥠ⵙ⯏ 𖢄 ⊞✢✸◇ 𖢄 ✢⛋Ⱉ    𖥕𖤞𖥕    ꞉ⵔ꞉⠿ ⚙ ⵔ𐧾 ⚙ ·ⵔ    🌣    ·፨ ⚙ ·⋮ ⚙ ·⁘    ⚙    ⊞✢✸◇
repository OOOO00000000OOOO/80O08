<script>
$(document).ready(function() {

function removeTag(html, tag, removeContent) {
    if (!tag) return html;

    if (removeContent) {
        // Remove entire tag including content (handles nested reasonably well)
        var regex = new RegExp("<" + tag + "[^>]*>[\\s\\S]*?<\\/" + tag + ">", "gi");
        html = html.replace(regex, "");
    } else {
        // Remove only opening and closing tags (keep content)
        var regexOpenClose = new RegExp("<\\/?"+tag+"[^>]*>", "gi");
        html = html.replace(regexOpenClose, "");
    }

    return html;
}


 function processText() {
    var input = $("#inputText").val();
    var tag = $("#tagSelect").val();
    var removeContent = $("#removeContent").is(":checked");

    var result = removeTag(input, tag, removeContent);
    $("#outputText").val(result);
}


    // Auto update on input or tag change
    $("#inputText, #tagSelect, #removeContent").on("input change", function() {

        processText();
    });

    // Clear
    $("#clearBtn").click(function() {
        $("#inputText").val("");
        $("#outputText").val("");
    });

    // Copy
    $("#copyBtn").click(function() {
        var output = $("#outputText");
        output.select();
        document.execCommand("copy");
    });

    // Download
    $("#downloadBtn").click(function() {
        var text = $("#outputText").val();
        var blob = new Blob([text], { type: "text/plain;charset=utf-8;" });
        var url = URL.createObjectURL(blob);

        var a = document.createElement("a");
        a.href = url;
        a.download = "cleaned-html.html";
        a.click();

        URL.revokeObjectURL(url);
    });

});
</script>
 
